# Copy to .env and adjust. All values have sane defaults in docker-compose.yml.

# --- Partitioning ---
PDF_CHUNK_SIZE=500

# --- Vertical scaling (per worker) ---
PDF_WORKER_CONCURRENCY=1
PDF_BATCH_SIZE=500
IMAGE_CONCURRENCY=4
IMAGE_TIMEOUT_MS=10000
IMAGE_MAX_SIZE_MB=5
IMAGE_RETRY=2
MAX_RETRIES=3

# --- Retention ---
EXPORT_TTL_HOURS=24

# --- Resource limits (docker compose) ---
WORKER_CPU_LIMIT=1.0
WORKER_MEM_LIMIT=1G
BACKEND_CPU_LIMIT=1.0
BACKEND_MEM_LIMIT=512M

# --- Demo data images (inside docker network) ---
DEMO_IMAGE_BASE_URL=http://backend:3000

# --- Public S3 endpoint for presigned download URLs (browser-facing) ---
S3_PUBLIC_ENDPOINT=localhost
S3_PUBLIC_PORT=9000
